<Window x:Class="SmartSocket.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Socket"
        Icon="Assets/smartsocket.ico"
        Height="700" Width="470"
        MinHeight="560" MinWidth="430"
        Background="{StaticResource Ink}">

    <!--
      THE PHONE'S LAYOUT, ON A WINDOW.

      Same wordmark and rule, same centred monogram, same "Choose a socket", same
      gold RUN under a "no hardware to hand" label. The two apps talk to one
      socket and are marked in the same term; looking like two different products
      was the last thing left undoing that.

      Every x:Name and every Click handler here is unchanged - the code-behind
      binds to all of them by name, and none of this touches what any of them do.
    -->

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ WORDMARK ============ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,26">
            <!-- Spaced in the string, because WPF has no letter-spacing and this
                 tracking is what ties the name to the monogram. -->
            <TextBlock Text="S M A R T   S O C K E T"
                       Foreground="{StaticResource Muted}"
                       FontSize="12" FontWeight="Medium" />
            <Border Style="{StaticResource Hairline}" Margin="0,12,0,0" />
            <TextBlock x:Name="LinkLine" Style="{StaticResource Caption}"
                       Text="Not connected" Margin="0,10,0,0" />
        </StackPanel>

        <!-- ============ CONNECT ============ -->
        <Grid Grid.Row="1" x:Name="ConnectView">
            <!-- Horizontal scrolling off, and that is what makes the text wrap:
                 an unconstrained ScrollViewer hands its content infinite width,
                 so every paragraph runs off the right edge instead. -->
            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <Image Source="Assets/logo_mark.png"
                           Width="132" Height="132"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28" />

                    <TextBlock Text="Choose a socket" Style="{StaticResource Heading}" />

                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="The USB cable and a Classic HC-05 appear as COM ports. A Bluetooth LE module appears by name, marked (Bluetooth LE) — it never gets a COM port." />

                    <TextBlock Text="DEVICES FOUND" Style="{StaticResource FieldLabel}"
                               Margin="0,22,0,0" />
                    <Border Style="{StaticResource Hairline}" Margin="0,8,0,0" />

                    <!-- A whole number of rows. At 150 the fourth was sliced
                         through the middle, which reads as the list having
                         failed to draw rather than as more of it below. -->
                    <ListBox x:Name="PortList" Height="176" Margin="0,0,0,16" />

                    <Button Content="CONNECT" Click="OnConnect"
                            Style="{StaticResource GoldButton}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,10" />
                    <Button x:Name="SearchButton" Content="SEARCH" Click="OnRefreshPorts"
                            HorizontalAlignment="Stretch" Margin="0" />

                    <!--
                      No inline error line here any more. A failure is a modal,
                      the way it is on the phone: this one sat under the button
                      for the rest of the session with nothing to clear it, and
                      on a long list it fell below the fold, so the tap looked
                      like it had simply done nothing.
                    -->

                    <Border Style="{StaticResource Hairline}" Margin="0,30,0,0" />

                    <TextBlock Text="NO HARDWARE TO HAND" Style="{StaticResource FieldLabel}"
                               Margin="0,20,0,0" />
                    <Button Content="RUN" Click="OnDemo"
                            Style="{StaticResource GoldButton}"
                            HorizontalAlignment="Stretch" Margin="0,12,0,0" />

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ DASHBOARD ============ -->
        <Grid Grid.Row="1" x:Name="DashboardView" Visibility="Collapsed">
            <!--
              Hidden, not Disabled. Hidden keeps the wheel, the keyboard and
              touch working and only takes away the bar; Disabled would stop the
              content scrolling at all and cut off the buttons on a short window.
            -->
            <!-- Horizontal scrolling off, and that is what makes the text wrap:
                 an unconstrained ScrollViewer hands its content infinite width,
                 so every paragraph runs off the right edge instead. -->
            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- The one panel that matters: state, then the number. -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <!-- A pill, as on the phone. The border takes its
                                 colour from the label, which the code already
                                 tints per state - so it follows along without
                                 anything new being told to do it. -->
                            <Border CornerRadius="999" Padding="14,7"
                                    Background="{StaticResource Surface2}"
                                    BorderThickness="1"
                                    BorderBrush="{Binding Foreground, ElementName=StateLabel}"
                                    HorizontalAlignment="Left">
                                <TextBlock x:Name="StateLabel" Text="—"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Gold}" />
                            </Border>

                            <TextBlock x:Name="CurrentReadout" Style="{StaticResource Readout}"
                                       Text="0.00 A" Margin="0,18,0,0" />

                            <TextBlock x:Name="StateDetail" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />

                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            ToolTip="The highest current seen this charge. Blank unless a charge session is running.">
                                    <TextBlock Text="PEAK" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="PeakReadout" Text="—" Style="{StaticResource Stat}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            ToolTip="What actually stops the charge. Your battery limit while the app is managing; the socket's own current threshold when it is not.">
                                    <TextBlock Text="CUTS AT" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="ThresholdReadout" Text="—" Style="{StaticResource Stat}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="RELAY" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="RelayReadout" Text="—" Style="{StaticResource Stat}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Controls sit directly on the ground, not in a card, so
                         they read as actions rather than as more readings. -->
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <Button Content="Cut power" Click="OnCut"
                                Foreground="{StaticResource Alarm}" BorderBrush="#8CD0492F" />
                        <Button Content="Re-arm" Click="OnRearm"
                                Foreground="{StaticResource Gold}" BorderBrush="#8CD4A537"
                                Margin="0" />
                    </UniformGrid>

                    <!--
                      "Probe" was a word from the firmware's vocabulary, shown
                      whether or not it could do anything. The phone names the
                      act instead, and only offers it where it means something -
                      there is nothing to check for while a charge is running.
                    -->
                    <Button x:Name="ProbeButton" Content="Check for a device now"
                            Click="OnProbe" Margin="0,0,0,14"
                            HorizontalAlignment="Stretch" Visibility="Collapsed" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="THIS LAPTOP" Style="{StaticResource FieldLabel}"
                                           HorizontalAlignment="Left" />
                                <TextBlock x:Name="BatteryReadout" Text="—"
                                           FontSize="16" FontWeight="Medium"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <TextBlock x:Name="BatteryNote" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,10,0,14" />

                            <CheckBox x:Name="CutOnLimitBox"
                                      Content="Let this app manage charging" Margin="0,0,0,16"
                                      Checked="OnCutOnLimitChanged" Unchecked="OnCutOnLimitChanged" />

                            <TextBlock x:Name="LimitLabel" Foreground="{StaticResource Gold}"
                                       FontSize="13" Text="Stop charging at 90%" />
                            <Slider x:Name="LimitSlider" Minimum="50" Maximum="100" TickFrequency="5"
                                    IsSnapToTickEnabled="True" Margin="0,10,0,0"
                                    ValueChanged="OnLimitChanged" />
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="50%" Style="{StaticResource FieldLabel}"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="100%" Style="{StaticResource FieldLabel}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="SESSION" Style="{StaticResource FieldLabel}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Content="HISTORY" Click="OnOpenHistory"
                                        Style="{StaticResource Chip}"
                                        HorizontalAlignment="Right" Margin="0" />
                            </Grid>
                            <TextBlock x:Name="SessionReadout" Text="—" Style="{StaticResource Stat}"
                                       Margin="0,14,0,0" />
                            <TextBlock x:Name="SavedReadout" Text="—" Style="{StaticResource Stat}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Button Content="DISCONNECT" Click="OnDisconnect"
                            Style="{StaticResource ChipAlarm}"
                            HorizontalAlignment="Right" Margin="0,0,0,8" />

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ HISTORY ============ -->
        <!--
          Rows, not a stack. The list used to be a fixed 380 tall inside a
          StackPanel, so on any window shorter than the content the Back button
          was pushed off the bottom edge - present in the markup, unreachable on
          screen, and there is no back gesture on Windows to fall back on. The
          list now takes whatever is left and Back is pinned below it.
        -->
        <Grid Grid.Row="1" x:Name="HistoryView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Grid Margin="0,0,0,22">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="History" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="Newest first. Export writes the same CSV the phone app does." />
                    </StackPanel>
                    <!-- Hidden when there is nothing recorded: there is nothing
                         to export and nothing to clear. -->
                    <StackPanel x:Name="HistoryActions" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="EXPORT" Click="OnExport" Style="{StaticResource Chip}" />
                        <Button Content="CLEAR" Click="OnClearHistory"
                                Style="{StaticResource ChipAlarm}" Margin="0" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Hairline}" />
            </StackPanel>

            <ListBox Grid.Row="1" x:Name="HistoryList" Margin="0,4,0,4" />

            <StackPanel Grid.Row="2">
                <Border Style="{StaticResource Hairline}" Margin="0,0,0,18" />
                <Button Content="Back" Click="OnCloseHistory"
                        HorizontalAlignment="Left" Margin="0" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="0,16,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Faint}"
                   Text="Closing this window keeps the socket watched from the tray. Quit from the tray icon to stop." />
    </Grid>
</Window>
